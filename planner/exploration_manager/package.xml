<?xml version="1.0"?>
<package format="2">
  <name>exploration_manager</name>
  <version>1.0.0</version>
  <description>Area exploration for the EGO planner: frontier exploration or a lawnmower of waypoints</description>

  <maintainer email="dev@1nrobotics.com">1nRobotics</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>plan_env</depend>
  <depend>traj_utils</depend>
  <depend>bspline_opt</depend>
  <depend>quadrotor_msgs</depend>
  <test_depend>rosunit</test_depend>

  <export>
  </export>
</package>

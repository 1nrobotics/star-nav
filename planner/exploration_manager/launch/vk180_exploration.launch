<launch>
  <!-- ============================== -->
  <!-- VK180 + PX4 + EGO + Exploration -->
  <!-- Complete Autonomous Exploration -->
  <!-- ============================== -->
  
  <arg name="drone_id" default="0"/>
  
  <!-- Map Parameters -->
  <arg name="map_size_x" default="50.0"/>
  <arg name="map_size_y" default="50.0"/>
  <arg name="map_size_z" default="5.0"/>
  
  <!-- ============================== -->
  <!-- 1. VK180 Vision Sensor         -->
  <!-- ============================== -->
  <!-- Assumes VK180 already running externally -->
  <!-- Topics: /vk180/odom_raw, /vk180/pointcloud -->
  
  <!-- VK180 Planner Bridge (Sensor Fusion) -->
  <node pkg="vk180_planner_bridge" type="vk180_planner_bridge" name="vk180_planner_bridge" output="screen">
    <param name="drone_id" value="$(arg drone_id)"/>
    <remap from="~odom_fused" to="/mavros/local_position/odom"/>
    <remap from="~odom_raw" to="/vk180/odom_raw"/>
  </node>
  
  <!-- ============================== -->
  <!-- 2. PX4 Flight Controller       -->
  <!-- ============================== -->
  <node pkg="px4ctrl" type="px4ctrl_node" name="px4ctrl_node" output="screen">
    <remap from="~odom" to="/mavros/local_position/odom"/>
    <remap from="~cmd" to="/drone_$(arg drone_id)_planning/pos_cmd"/>
    <rosparam file="$(find px4ctrl)/config/ctrl_param_fpv.yaml"/>
    <param name="use_bodyrate_ctrl" value="false"/>
  </node>
  
  <!-- ============================== -->
  <!-- 3. EGO Planner (Trajectory Gen)-->
  <!-- ============================== -->
  <node pkg="ego_planner" name="drone_$(arg drone_id)_ego_planner" type="ego_planner_node" output="screen">
    <remap from="~odom_world" to="/mavros/local_position/odom"/>
    <remap from="~planning/bspline" to="/drone_$(arg drone_id)_planning/bspline"/>
    <remap from="~planning/data_display" to="/drone_$(arg drone_id)_planning/data_display"/>
    <remap from="~planning/broadcast_bspline_from_planner" to="/broadcast_bspline"/>
    <remap from="~planning/broadcast_bspline_to_planner" to="/broadcast_bspline"/>
    <remap from="~grid_map/odom" to="/mavros/local_position/odom"/>
    <remap from="~grid_map/cloud" to="/vk180/pointcloud"/>
    <remap from="~grid_map/pose" to="/mavros/local_position/pose"/>
    <remap from="~grid_map/depth" to="/vk180/pointcloud"/>

    <!-- Planner Parameters -->
    <param name="manager/max_vel" value="1.0" type="double"/>
    <param name="manager/max_acc" value="1.0" type="double"/>
    <param name="manager/max_jerk" value="4.0" type="double"/>
    <param name="manager/dynamic_environment" value="1" type="int"/>
    <param name="manager/clearance_threshold" value="0.2" type="double"/>
    <param name="manager/local_segment_length" value="3.0" type="double"/>

    <!-- Optimization Parameters -->
    <param name="optimization/lambda_smooth" value="1.0" type="double"/>
    <param name="optimization/lambda_collision" value="0.5" type="double"/>
    <param name="optimization/lambda_feasibility" value="0.1" type="double"/>
    <param name="optimization/lambda_fitness" value="1.0" type="double"/>
    <param name="optimization/dist0" value="0.4" type="double"/>
    <param name="optimization/max_vel" value="1.0" type="double"/>
    <param name="optimization/max_acc" value="1.0" type="double"/>

    <!-- Grid Map -->
    <param name="grid_map/resolution" value="0.1" type="double"/>
    <param name="grid_map/map_size_x" value="$(arg map_size_x)" type="double"/>
    <param name="grid_map/map_size_y" value="$(arg map_size_y)" type="double"/>
    <param name="grid_map/map_size_z" value="$(arg map_size_z)" type="double"/>
    <!-- IMPORTANT: Must be >= max_exploration_radius to avoid forgetting old map data -->
    <param name="grid_map/local_update_range_x" value="30.0" type="double"/>  <!-- Was 5.5 -->
    <param name="grid_map/local_update_range_y" value="30.0" type="double"/>  <!-- Was 5.5 -->
    <param name="grid_map/local_update_range_z" value="5.0" type="double"/>   <!-- Was 3.5 -->
    <param name="grid_map/obstacles_inflation" value="0.3" type="double"/>

    <!-- FSM (not used in exploration mode) -->
    <param name="fsm/flight_type" value="3" type="int"/> <!-- 3 = EXPLORATION -->
    <param name="fsm/thresh_replan" value="1.5" type="double"/>
    <param name="fsm/thresh_no_replan" value="2.0" type="double"/>
  </node>
  
  <!-- ============================== -->
  <!-- 4. Exploration Manager         -->
  <!-- ============================== -->
  <node pkg="exploration_manager" type="exploration_node" name="exploration_node" output="screen">
    
    <!-- FSM Parameters -->
    <param name="fsm/fsm_exec_dt" value="0.1" type="double"/>
    <param name="fsm/replan_time" value="0.05" type="double"/>
    <param name="fsm/max_exploration_time" value="600.0" type="double"/> <!-- 10 minutes -->
    <param name="fsm/frontier_search_interval" value="3.0" type="double"/>
    
    <!-- Frontier Finder Parameters -->
    <param name="exploration/frontier_cluster_min_size" value="0.5" type="double"/>
    <param name="exploration/frontier_search_radius" value="10.0" type="double"/>
    <param name="exploration/frontier_min_cells" value="10" type="int"/>
    <param name="exploration/viewpoint_distance" value="2.5" type="double"/>
    <param name="exploration/viewpoint_num" value="8" type="int"/>
    
    <!-- Geofence Parameters (NEW) -->
    <param name="exploration/use_geofence" value="true" type="bool"/>
    <param name="exploration/max_exploration_radius" value="25.0" type="double"/>
    <param name="exploration/exploration_center_x" value="0.0" type="double"/>
    <param name="exploration/exploration_center_y" value="0.0" type="double"/>
    <param name="exploration/exploration_center_z" value="1.5" type="double"/>
    
    <!-- Explored Region Tracking (NEW) -->
    <!-- 0.0 = never revisit explored regions (permanent memory) -->
    <!-- >0.0 = allow revisit after N seconds (for dynamic environments) -->
    <param name="exploration/explored_cell_expiry_time" value="0.0" type="double"/>
    
    <!-- Map Parameters (must match EGO planner) -->
    <param name="grid_map/resolution" value="0.1" type="double"/>
    <param name="grid_map/map_size_x" value="$(arg map_size_x)" type="double"/>
    <param name="grid_map/map_size_y" value="$(arg map_size_y)" type="double"/>
    <param name="grid_map/map_size_z" value="$(arg map_size_z)" type="double"/>
    <!-- IMPORTANT: Must be >= max_exploration_radius to avoid forgetting old map data -->
    <param name="grid_map/local_update_range_x" value="30.0" type="double"/>
    <param name="grid_map/local_update_range_y" value="30.0" type="double"/>
    <param name="grid_map/local_update_range_z" value="5.0" type="double"/>
    <param name="grid_map/obstacles_inflation" value="0.3" type="double"/>
    
    <!-- Topic remapping -->
    <remap from="/exploration_node/odom" to="/mavros/local_position/odom"/>
    <remap from="/exploration_node/cloud" to="/vk180/pointcloud"/>
    
  </node>
  
  <!-- ============================== -->
  <!-- 5. Visualization (Optional)    -->
  <!-- ============================== -->
  <!-- Uncomment to launch RViz -->
  <!--
  <node pkg="rviz" type="rviz" name="exploration_rviz" 
        args="-d $(find exploration_manager)/launch/exploration.rviz"/>
  -->
  
</launch>

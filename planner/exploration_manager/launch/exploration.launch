<launch>
  <!-- Standalone example of the exploration node. The simulation starts it
       from star_nav_bringup/launch/planning_stack.xml instead.
       Frontier mode needs the planner's map slice: set grid_map/slice_min_z
       and grid_map/slice_max_z on the EGO planner node (around the altitude)
       and point `slice` below at its grid_map/slice topic. -->
  <arg name="mode" default="frontier"/>
  <arg name="slice_topic" default="/drone_0_ego_planner_node/grid_map/slice"/>
  <arg name="odom_topic" default="/mavros/local_position/odom"/>

  <node pkg="exploration_manager" type="exploration_node" name="exploration_node" output="screen">
    <remap from="/mavros/local_position/odom" to="$(arg odom_topic)"/>
    <remap from="~slice" to="$(arg slice_topic)"/>

    <!-- frontier or waypoint -->
    <param name="exploration/mode" value="$(arg mode)"/>

    <!-- Area (both modes) -->
    <param name="exploration/center_x" value="0.0" type="double"/>
    <param name="exploration/center_y" value="0.0" type="double"/>
    <param name="exploration/width" value="10.0" type="double"/>
    <param name="exploration/height" value="10.0" type="double"/>
    <param name="exploration/altitude" value="1.0" type="double"/>
    <param name="fsm/max_exploration_time" value="600.0" type="double"/>
    <param name="fsm/waypoint_tolerance" value="0.5" type="double"/>

    <!-- Waypoint mode -->
    <param name="exploration/line_spacing" value="3.0" type="double"/>
    <param name="fsm/waypoint_timeout" value="30.0" type="double"/>

    <!-- Frontier mode (README.md) -->
    <param name="frontier/inflation" value="0.3" type="double"/>
  </node>
</launch>

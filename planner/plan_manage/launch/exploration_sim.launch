<launch>
    <!-- ============================================ -->
    <!-- Exploration System Simulation               -->
    <!-- Based on single_run_in_sim.launch           -->
    <!-- ============================================ -->
    <!-- Trigger exploration: rostopic pub /exploration/trigger geometry_msgs/PoseStamped "{}" -->
    <!-- 2D Nav Goal in RViz goes to EGO planner directly -->

    <!-- Arguments -->
    <arg name="drone_id" default="0"/>
    <arg name="obj_num" default="10" />

    <!-- Map Parameters -->
    <arg name="map_size_x" default="50.0"/>
    <arg name="map_size_y" default="50.0"/>
    <arg name="map_size_z" default="5.0"/>
    <arg name="odom_topic" default="visual_slam/odom" />

    <!-- Exploration Parameters -->
    <arg name="exploration_center_x" default="0.0"/>
    <arg name="exploration_center_y" default="0.0"/>
    <arg name="exploration_width" default="20.0"/>
    <arg name="exploration_height" default="20.0"/>
    <arg name="line_spacing" default="2.0"/>

    <!-- ============================== -->
    <!-- 1. Map Generator               -->
    <!-- ============================== -->
    <node pkg ="map_generator" name ="random_forest" type ="random_forest" output = "screen">
        <param name="map/x_size" value="$(arg map_size_x)" />
        <param name="map/y_size" value="$(arg map_size_y)" />
        <param name="map/z_size" value="$(arg map_size_z)" />
        <param name="map/resolution" value="0.1"/>
        <param name="ObstacleShape/seed" value="1"/>
        <param name="map/obs_num" value="100"/>
        <param name="ObstacleShape/lower_rad" value="0.5"/>
        <param name="ObstacleShape/upper_rad" value="0.7"/>
        <param name="ObstacleShape/lower_hei" value="0.0"/>
        <param name="ObstacleShape/upper_hei" value="3.0"/>
        <param name="map/circle_num" value="50"/>
        <param name="ObstacleShape/radius_l" value="0.7"/>
        <param name="ObstacleShape/radius_h" value="0.5"/>
        <param name="ObstacleShape/z_l" value="0.7"/>
        <param name="ObstacleShape/z_h" value="0.8"/>
        <param name="ObstacleShape/theta" value="0.5"/>
        <param name="pub_rate" value="1.0"/>
        <param name="min_distance" value="0.8"/>
    </node>

    <!-- ============================== -->
    <!-- 2. EGO Planner                 -->
    <!-- ============================== -->
    <include file="$(find ego_planner)/launch/advanced_param.xml">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="map_size_x_" value="$(arg map_size_x)"/>
        <arg name="map_size_y_" value="$(arg map_size_y)"/>
        <arg name="map_size_z_" value="$(arg map_size_z)"/>
        <arg name="odometry_topic" value="$(arg odom_topic)"/>
        <arg name="obj_num_set" value="$(arg obj_num)" />

        <!-- Use simulated sensing -->
        <arg name="camera_pose_topic" value="pcl_render_node/camera_pose"/>
        <arg name="depth_topic" value="pcl_render_node/depth"/>
        <arg name="cloud_topic" value="pcl_render_node/cloud"/>

        <!-- Camera intrinsics -->
        <arg name="cx" value="321.04638671875"/>
        <arg name="cy" value="243.44969177246094"/>
        <arg name="fx" value="387.229248046875"/>
        <arg name="fy" value="387.229248046875"/>

        <!-- Planning parameters -->
        <arg name="max_vel" value="1.5" />
        <arg name="max_acc" value="3.0" />
        <arg name="planning_horizon" value="7.5" />
        <arg name="use_distinctive_trajs" value="false" />

        <!-- Manual target mode for exploration -->
        <arg name="flight_type" value="1" />

        <!-- Dummy waypoints (not used in manual mode) -->
        <arg name="point_num" value="0" />
        <arg name="point0_x" value="0" />
        <arg name="point0_y" value="0" />
        <arg name="point0_z" value="0" />
        <arg name="point1_x" value="0" />
        <arg name="point1_y" value="0" />
        <arg name="point1_z" value="0" />
        <arg name="point2_x" value="0" />
        <arg name="point2_y" value="0" />
        <arg name="point2_z" value="0" />
        <arg name="point3_x" value="0" />
        <arg name="point3_y" value="0" />
        <arg name="point3_z" value="0" />
        <arg name="point4_x" value="0" />
        <arg name="point4_y" value="0" />
        <arg name="point4_z" value="0" />
    </include>

    <!-- ============================== -->
    <!-- 3. Trajectory Server           -->
    <!-- ============================== -->
    <node pkg="ego_planner" name="drone_$(arg drone_id)_traj_server" type="traj_server" output="screen">
        <remap from="~planning/bspline" to="drone_$(arg drone_id)_planning/bspline"/>
        <remap from="/position_cmd" to="/drone_$(arg drone_id)_planning/pos_cmd"/>
        <param name="traj_server/time_forward" value="1.0" type="double"/>
    </node>

    <!-- ============================== -->
    <!-- 4. Exploration Manager         -->
    <!-- ============================== -->
    <node pkg="exploration_manager" type="exploration_node" name="exploration_node" output="screen">
        
        <!-- Remap odometry for simulation -->
        <remap from="/mavros/local_position/odom" to="/drone_$(arg drone_id)_$(arg odom_topic)"/>
        
        <!-- Simulation mode -->
        <param name="use_sim" value="true" />

        <!-- FSM Parameters -->
        <param name="fsm/fsm_exec_dt" value="0.1" type="double"/>
        <param name="fsm/replan_time" value="0.05" type="double"/>
        <param name="fsm/max_exploration_time" value="300.0" type="double"/>
        <param name="fsm/waypoint_timeout" value="30.0" type="double"/>

        <!-- Waypoint Mode Parameters -->
        <param name="exploration/center_x" value="$(arg exploration_center_x)" type="double"/>
        <param name="exploration/center_y" value="$(arg exploration_center_y)" type="double"/>
        <param name="exploration/center_z" value="1.5" type="double"/>
        <param name="exploration/width" value="$(arg exploration_width)" type="double"/>
        <param name="exploration/height" value="$(arg exploration_height)" type="double"/>
        <param name="exploration/altitude" value="1.5" type="double"/>
        <param name="exploration/line_spacing" value="$(arg line_spacing)" type="double"/>
    </node>

    <!-- ============================== -->
    <!-- 5. RViz Visualization          -->
    <!-- ============================== -->
    <node name="rviz" pkg="rviz" type="rviz"
          args="-d $(find vk180_ros)/config/vk180_planner_visualization.rviz"
          required="true" />

    <!-- ============================== -->
    <!-- 6. Simulator                   -->
    <!-- ============================== -->
    <include file="$(find ego_planner)/launch/simulator.xml">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="map_size_x_" value="$(arg map_size_x)"/>
        <arg name="map_size_y_" value="$(arg map_size_y)"/>
        <arg name="map_size_z_" value="$(arg map_size_z)"/>
        <arg name="init_x_" value="0"/>
        <arg name="init_y_" value="0"/>
        <arg name="init_z_" value="1.0"/>
        <arg name="odometry_topic" value="$(arg odom_topic)" />
    </include>

    <!-- ============================== -->
    <!-- 7. Static TF Publishers        -->
    <!-- ============================== -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_map"
          args="0 0 0 0 0 0 world map" />

    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom"
          args="0 0 0 0 0 0 world odom" />

</launch>
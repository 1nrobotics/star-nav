<?xml version="1.0"?>
<launch>
    <!-- Deep Robotics Lite3 Quadruped Navigation with VK180 and EGO Planner -->
    
    <!-- Arguments -->
    <arg name="use_sim" default="false" />
    <arg name="use_body_frame_transform" default="true" />
    
    <!-- EGO Planner Arguments -->
    <arg name="drone_id" default="0"/>
    <arg name="map_size_x" default="50"/>
    <arg name="map_size_y" default="25"/>
    <arg name="map_size_z" default="3.0"/>
    <arg name="use_rviz" default="true"/>
    <arg name="flight_type" default="1" /> <!-- 1=2D Nav Goal, 2=Waypoints -->
    
    <!-- Lite3 velocity limits (conservative for quadruped) -->
    <arg name="max_vel" default="0.8" />  <!-- 0.8 m/s for quadruped -->
    <arg name="max_acc" default="1.5" />  <!-- 1.5 m/s² for quadruped -->
    
    <!-- Lite3 Controller Parameters -->
    <arg name="max_linear_vel" default="1.0" />
    <arg name="max_angular_vel" default="1.0" />
    <arg name="position_gain" default="0.5" />
    <arg name="velocity_alpha" default="0.3" />
    <arg name="control_rate" default="50.0" />
    
    <!-- VK180 Planner Bridge - Provides odometry and sensor data -->
    <node name="vk180_planner_bridge" 
          pkg="vk180_ros" 
          type="vk180_planner_bridge" 
          output="screen">
        
        <!-- Frame IDs -->
        <param name="odom_frame_id" value="odom" />
        <param name="base_frame_id" value="base_link" />
        
        <!-- Depth Processing Parameters -->
        <param name="use_body_frame_transform" value="$(arg use_body_frame_transform)" />
        <param name="subscribe_to_image_stream" value="true" />
        <param name="max_depth" value="8.0" />
        <param name="min_depth" value="0.3" />
    </node>
    
    <!-- Lite3 Message Transformer - Bridge between ROS and Lite3 robot -->
    <!-- Publishes: /leg_odom, /imu/data, /joint_states -->
    <!-- Subscribes: /cmd_vel (sends to robot via UDP) -->
    <include file="$(find message_transformer)/launch/message_transformer.launch" />
    
    <!-- Lite3 Velocity Controller - Converts trajectory to velocity commands -->
    <node pkg="lite3_ctrl" type="lite3_velocity_controller" name="lite3_velocity_controller" output="screen">
        <!-- Remap to use Lite3 leg odometry for state feedback -->
        <remap from="/mavros/local_position/odom" to="/leg_odom2" />
        
        <!-- Remap cmd_vel output to Lite3's topic (message_transformer subscribes to /cmd_vel) -->
        <remap from="/lite3/cmd_vel" to="/cmd_vel" />
        
        <param name="max_linear_vel" value="$(arg max_linear_vel)" />
        <param name="max_angular_vel" value="$(arg max_angular_vel)" />
        <param name="position_gain" value="$(arg position_gain)" />
        <param name="velocity_alpha" value="$(arg velocity_alpha)" />
        <param name="control_rate" value="$(arg control_rate)" />
        <param name="odom_timeout" value="0.5" />
        <param name="cmd_timeout" value="1.0" />
    </node>
    
    <!-- EGO Planner with VK180 Topics -->
    <include file="$(find ego_planner)/launch/advanced_param_exp.xml">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="map_size_x_" value="$(arg map_size_x)"/>
        <arg name="map_size_y_" value="$(arg map_size_y)"/>
        <arg name="map_size_z_" value="$(arg map_size_z)"/>
        
        <!-- Use Lite3 leg odometry from message_transformer (nav_msgs/Odometry) -->
        <arg name="odometry_topic" value="/leg_odom2"/>
        <arg name="depth_topic" value="nouse1"/>
        <arg name="camera_pose_topic" value="nouse2"/>
        <arg name="cloud_topic" value="/vk180/pointcloud"/>
        
        <!-- Camera Intrinsics (not used for point cloud mapping) -->
        <arg name="cx" value="320.0"/>
        <arg name="cy" value="240.0"/>
        <arg name="fx" value="400.0"/>
        <arg name="fy" value="400.0"/>
        
        <!-- Planning Parameters (tuned for quadruped) -->
        <arg name="max_vel" value="$(arg max_vel)" />
        <arg name="max_acc" value="$(arg max_acc)" />
        <arg name="planning_horizon" value="6" />
        <arg name="use_distinctive_trajs" value="false" />
        
        <!-- Flight Mode: 1=2D Nav Goal, 2=Waypoints -->
        <arg name="flight_type" value="$(arg flight_type)" />
        
        <!-- Test Waypoints (smaller scale for quadruped) -->
        <arg name="point_num" value="5" />
        <arg name="point0_x" value="3.0" />
        <arg name="point0_y" value="0.0" />
        <arg name="point0_z" value="0.5" />
        <arg name="point1_x" value="0.0" />
        <arg name="point1_y" value="3.0" />
        <arg name="point1_z" value="0.5" />
        <arg name="point2_x" value="-3.0" />
        <arg name="point2_y" value="0.0" />
        <arg name="point2_z" value="0.5" />
        <arg name="point3_x" value="0.0" />
        <arg name="point3_y" value="-3.0" />
        <arg name="point3_z" value="0.5" />
        <arg name="point4_x" value="0.0" />
        <arg name="point4_y" value="0.0" />
        <arg name="point4_z" value="0.5" />
        
        <!-- Moving Objects -->
        <arg name="obj_num_set" value="0" />
    </include>
    
    <!-- Trajectory Server -->
    <node pkg="ego_planner" name="drone_$(arg drone_id)_traj_server" type="traj_server" output="screen">
        <remap from="~planning/bspline" to="drone_$(arg drone_id)_planning/bspline"/>
        <remap from="/position_cmd" to="/drone_$(arg drone_id)_planning/pos_cmd"/>
        <param name="traj_server/time_forward" value="1.0" type="double"/>
    </node>
    
    <!-- Static TF Publishers -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_map"
          args="0 0 0 0 0 0 world map" />
    
    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom"
          args="0 0 0 0 0 0 world odom" />
    
    <!-- Odometry TF (odom -> base_link) published dynamically by vk180_planner_bridge -->
    
    <!-- Camera transform published dynamically by vk180_planner_bridge from VK180 extrinsics -->
    
    <!-- Optional: Static transform for camera optical frame -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="camera_to_camera_optical"
          args="0 0 0 -1.5708 0 -1.5708 camera_link camera_optical_frame" />
    
    <!-- RViz Visualization -->
    <node name="rviz" pkg="rviz" type="rviz" 
          args="-d $(find vk180_ros)/config/vk180_planner_visualization.rviz" 
          if="$(arg use_rviz)" />
    
</launch>

<launch>
    <!-- Headless end-to-end check with the T1 humanoid in MuJoCo:
         rostest star_nav_bringup t1_smoke.test
         Needs the robot (the t1 option of scripts/setup_mujoco_env.sh) and
         the CMU planner's paths (scripts/fetch_cmu_paths.sh): the T1 walks
         with the CMU planner only (docs/PLANNER_INTERFACE.md).
         By default it walks the mission through the house, over a ramp, a
         platform and stairs (it must get onto the platform), with the lidar.
         world:=forest walks it through the pillar forest. -->
    <arg name="exploration_width" default="9.0"/>
    <arg name="exploration_height" default="9.0"/>
    <arg name="line_spacing" default="3.0"/>
    <arg name="expected_waypoints" default="12"/>
    <arg name="start_sim" default="true"/>
    <arg name="sim_host" default="127.0.0.1"/>
    <arg name="sim_args" default=""/>
    <arg name="lidar" default="uniform"/>
    <arg name="world" default="house"/>

    <include file="$(find star_nav_bringup)/launch/exploration_t1.launch">
        <arg name="use_rviz" value="false"/>
        <arg name="viewer" value="false"/>
        <arg name="start_sim" value="$(arg start_sim)"/>
        <arg name="sim_host" value="$(arg sim_host)"/>
        <arg name="sim_args" value="$(arg sim_args)"/>
        <arg name="lidar" value="$(arg lidar)"/>
        <arg name="world" value="$(arg world)"/>
        <arg name="exploration_width" value="$(arg exploration_width)"/>
        <arg name="exploration_height" value="$(arg exploration_height)"/>
        <arg name="line_spacing" value="$(arg line_spacing)"/>
    </include>

    <test test-name="t1_smoke" pkg="star_nav_bringup" type="sim_smoke_test.py" time-limit="600.0">
        <param name="expected_waypoints" value="$(arg expected_waypoints)"/>
        <param name="exploration_width" value="$(arg exploration_width)"/>
        <param name="exploration_height" value="$(arg exploration_height)"/>
        <param name="contacts_topic" value="/mujoco/contacts"/>
        <!-- House: the trunk (0.67 m above the feet) on the 0.21 m platform -->
        <param name="min_peak_height" value="0.8" if="$(eval world == 'house')"/>
        <param name="mission_timeout" value="420.0"/>
    </test>
</launch>

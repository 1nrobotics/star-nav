<launch>
    <!-- Headless end-to-end check of frontier exploration with the quadrotor
         in MuJoCo:
         rostest star_nav_bringup mujoco_frontier_smoke.test
         No waypoints are given: from its start in the middle of the pillar
         forest the quadrotor has to map the exploration area and what
         frontier_margin adds around it, come back, and touch nothing on the
         way. It flies with EGO-Planner and the 360-degree lidar. -->
    <arg name="exploration_width" default="9.0"/>
    <arg name="exploration_height" default="9.0"/>
    <arg name="frontier_margin" default="1.5"/>
    <arg name="start_sim" default="true"/>
    <arg name="sim_host" default="127.0.0.1"/>
    <arg name="sim_args" default=""/>
    <arg name="lidar" default="uniform"/>
    <arg name="min_coverage" default="0.95"/>
    <arg name="half_x" value="$(eval exploration_width / 2.0 + frontier_margin)"/>
    <arg name="half_y" value="$(eval exploration_height / 2.0 + frontier_margin)"/>

    <include file="$(find star_nav_bringup)/launch/exploration_mujoco.launch">
        <arg name="use_rviz" value="false"/>
        <arg name="viewer" value="false"/>
        <arg name="start_sim" value="$(arg start_sim)"/>
        <arg name="sim_host" value="$(arg sim_host)"/>
        <arg name="sim_args" value="$(arg sim_args)"/>
        <arg name="lidar" value="$(arg lidar)"/>
        <arg name="exploration_width" value="$(arg exploration_width)"/>
        <arg name="exploration_height" value="$(arg exploration_height)"/>
        <arg name="frontier_margin" value="$(arg frontier_margin)"/>
        <arg name="explore" value="frontier"/>
    </include>

    <test test-name="mujoco_frontier_smoke" pkg="star_nav_bringup" type="frontier_smoke_test.py" time-limit="400.0">
        <param name="contacts_topic" value="/mujoco/contacts"/>
        <!-- The area the explorer may go to, around the origin -->
        <rosparam param="area" subst_value="true">[-$(arg half_x), -$(arg half_y), $(arg half_x), $(arg half_y)]</rosparam>
        <param name="min_coverage" value="$(arg min_coverage)"/>
        <param name="mission_timeout" value="240.0"/>
    </test>
</launch>

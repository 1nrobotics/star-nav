<?xml version="1.0"?>
<package format="2">
  <name>star_nav_bringup</name>
  <version>1.0.0</version>
  <description>Launch files, RViz config and simulation smoke tests for Star Nav</description>

  <maintainer email="dev@1nrobotics.com">1nRobotics</maintainer>

  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>ego_planner</exec_depend>
  <exec_depend>exploration_manager</exec_depend>
  <exec_depend>map_generator</exec_depend>
  <exec_depend>local_sensing_node</exec_depend>
  <exec_depend>poscmd_2_odom</exec_depend>
  <exec_depend>odom_visualization</exec_depend>
  <exec_depend>mujoco_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>rviz_gcs_plugin</exec_depend>
  <!-- scripts/terrain_filter.py (walking robots) -->
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>rostest</test_depend>
  <test_depend>rospy</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>nav_msgs</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
</package>

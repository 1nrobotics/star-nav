<launch>
    <!-- Exploration with DeepRobotics' Lite3 quadruped in MuJoCo:
         roslaunch star_nav_bringup exploration_lite3.launch use_rviz:=true
         Download the robot once first: the lite3 option of
         scripts/setup_mujoco_env.sh (docs/SIMULATION.md)
         The lidar is on the back, 10 cm above the torso centre, seeing -30
         to 52 deg (a Mid-360, -7 to 52, tilted forward sees about this far
         down ahead). -->
    <arg name="robot" value="lite3"/>
    <arg name="robot_type" value="legged"/>
    <!-- The Lite3: torso at 0.34 m; it walks under a table (0.75 m) and
         climbs 7 cm steps -->
    <arg name="altitude" value="0.34"/>
    <arg name="lidar_offset" value="[0.0, 0.0, 0.10]"/>
    <arg name="robot_height" value="0.55"/>
    <arg name="max_step" default="0.09"/>
    <arg name="obstacles_inflation" default="0.3"/>
    <arg name="max_vel" value="0.6"/>

    <!-- The rest is in exploration_ground.launch, which takes more options
         than these -->
    <arg name="use_rviz" default="false"/>
    <arg name="viewer" default="true"/>
    <arg name="viewer_port" default="8080"/>
    <arg name="start_sim" default="true"/>
    <arg name="sim_host" default="127.0.0.1"/>
    <arg name="sim_args" default=""/>
    <arg name="seed" default="1"/>
    <!-- Lidar model (uniform or mid360); house or forest -->
    <arg name="lidar" default="uniform"/>
    <arg name="world" default="house"/>
    <arg name="exploration_width" default="9.0"/>
    <arg name="exploration_height" default="9.0"/>
    <arg name="line_spacing" default="3.0"/>
    <!-- waypoints, or frontier: map the place without preset waypoints -->
    <arg name="explore" default="waypoints"/>

    <include file="$(find star_nav_bringup)/launch/exploration_ground.launch" pass_all_args="true"/>
</launch>

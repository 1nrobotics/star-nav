<launch>
    <!-- ================================================ -->
    <!-- Exploration with a ground robot (MuJoCo)           -->
    <!-- ================================================ -->
    <!-- The part every ground robot shares. Start it through the robot's own
         launch file (exploration_lite3.launch, exploration_t1.launch),
         which sets the robot's sizes below.

         The simulator and the exploration manager of
         exploration_mujoco.launch, on a robot that walks or drives. The
         simulator moves it with the robot's own velocity policy
         (mujoco_sim/star_nav_mujoco/robots/).

         The planner is the robot type's (launch/planner.xml,
         docs/PLANNER_INTERFACE.md): CMU's terrain analysis, local planner
         and path follower (planners/cmu.xml) send the robot a velocity.
         They take the lidar's scans. Download the planner's paths once:
         scripts/fetch_cmu_paths.sh.

         world:=forest      the quadrotor's pillar forest instead of the
                            default house (rooms with furniture, a ramp, a
                            platform and stairs; mujoco_sim/star_nav_mujoco/house.py)
         explore:=frontier  no preset waypoints: the robot maps the place by
                            walking to what it has not seen yet
                            (scripts/frontier_explorer.py).
                            It stays inside the exploration area plus
                            frontier_margin

         start_sim:=false   simulator already running (e.g. in Docker)
         viewer:=false      no web viewer (headless runs, CI) -->

    <!-- The robot: a module of mujoco_sim/star_nav_mujoco/robots/ -->
    <arg name="robot"/>
    <!-- What kind it is, which chooses its planner (launch/planner.xml) -->
    <arg name="robot_type"/>
    <!-- Its sizes, set by its launch file. altitude and lidar_offset repeat
         stand_height and lidar_mount of the robot's module
         (mujoco_sim/tests/test_robots.py checks them).
         altitude: height its body stands at (the height of the goals)
         lidar_offset: lidar position in the body frame
         robot_height: returns above this are overhead, not obstacles
         max_step: the highest step that is walkable (frontier exploration)
         obstacles_inflation: clearance frontier exploration keeps
         max_vel: speed the planner walks it at (m/s) -->
    <arg name="altitude"/>
    <arg name="lidar_offset"/>
    <arg name="robot_height"/>
    <arg name="max_step"/>
    <arg name="obstacles_inflation"/>
    <arg name="max_vel"/>

    <arg name="drone_id" default="0"/>
    <arg name="obj_num" default="10"/>
    <arg name="use_rviz" default="false"/>

    <arg name="map_size_x" default="50.0"/>
    <arg name="map_size_y" default="50.0"/>
    <arg name="map_size_z" default="2.0"/>
    <arg name="odom_topic" default="visual_slam/odom"/>

    <arg name="exploration_center_x" default="0.0"/>
    <arg name="exploration_center_y" default="0.0"/>
    <arg name="exploration_width" default="9.0"/>
    <arg name="exploration_height" default="9.0"/>
    <arg name="line_spacing" default="3.0"/>
    <arg name="enable_corner_smoothing" default="false"/>
    <!-- waypoints (the lawnmower rows above) or frontier -->
    <arg name="explore" default="waypoints"/>
    <arg name="frontier_margin" default="1.5"/>

    <!-- Simulator -->
    <arg name="start_sim" default="true"/>
    <arg name="viewer" default="true"/>
    <arg name="viewer_port" default="8080"/>
    <arg name="seed" default="1"/>
    <arg name="sim_host" default="127.0.0.1"/>
    <arg name="sim_args" default=""/>
    <arg name="use_sim_time" default="true"/>
    <!-- Lidar model the simulator imitates: uniform (ideal spinning lidar)
         or mid360 (Livox Mid-360; fetch its beam table first, see
         docs/SIMULATION.md) -->
    <arg name="lidar" default="uniform"/>
    <arg name="world" default="house"/>
    <!-- auto (a legged robot's planner: cmu) or its name; see
         docs/GROUND_PLANNING.md -->
    <arg name="planner" default="auto"/>
    <!-- cmu: height above the ground from which a point is an obstacle, and
         the scale of its paths (clearance 0.45 m and length 3 m, times it) -->
    <arg name="cmu_obstacle_height" default="0.15"/>
    <arg name="cmu_path_scale" default="1.0"/>
    <arg name="cmu_min_path_scale" default="0.5"/>
    <param name="/use_sim_time" value="$(arg use_sim_time)"/>

    <!-- ============================== -->
    <!-- 1. MuJoCo simulator (no ROS)   -->
    <!-- ============================== -->
    <arg name="viewer_flag" value="--viewer-port $(arg viewer_port)" if="$(arg viewer)"/>
    <arg name="viewer_flag" value="--no-viewer" unless="$(arg viewer)"/>
    <node if="$(arg start_sim)" pkg="star_nav_bringup" type="mujoco_sim.sh"
          name="mujoco_sim" output="screen" required="true"
          args="--robot $(arg robot) --world $(arg world) --seed $(arg seed) --map-size $(arg map_size_x) $(arg map_size_y) --sensor lidar --lidar-model $(arg lidar) $(arg viewer_flag) $(arg sim_args)"/>

    <!-- ============================== -->
    <!-- 2. ROS bridge                  -->
    <!-- ============================== -->
    <node pkg="mujoco_bridge" type="mujoco_bridge_node" name="mujoco_bridge" output="screen" required="true">
        <param name="state_address" value="tcp://$(arg sim_host):5555"/>
        <param name="cmd_address" value="tcp://$(arg sim_host):5556"/>
        <remap from="odom" to="/drone_$(arg drone_id)_$(arg odom_topic)"/>
        <remap from="depth" to="/drone_$(arg drone_id)_pcl_render_node/depth"/>
        <remap from="camera_pose" to="/drone_$(arg drone_id)_pcl_render_node/camera_pose"/>
        <remap from="lidar_cloud" to="/drone_$(arg drone_id)_lidar/cloud"/>
        <remap from="lidar_pose" to="/drone_$(arg drone_id)_lidar/pose"/>
        <remap from="global_cloud" to="/map_generator/global_cloud"/>
        <remap from="contacts" to="/mujoco/contacts"/>
        <remap from="obstacles" to="/mujoco/obstacles"/>
        <remap from="pos_cmd" to="/drone_$(arg drone_id)_planning/pos_cmd"/>
        <remap from="cmd_vel" to="/cmd_vel"/>
        <!-- The planner's paths in the simulator's viewer, on the ground
             under the robot: the path it follows (red), the paths it chose
             from (green) and the router's route (yellow) -->
        <param name="draw_height" value="$(eval 0.04 - arg('altitude'))"/>
        <remap from="plan_path" to="/path"/>
        <remap from="candidate_paths" to="/free_paths"/>
        <remap from="route_path" to="/cmu_route"/>
        <remap from="waypoint_markers" to="/exploration_node/exploration/waypoints"
               unless="$(eval explore == 'frontier')"/>
        <!-- Frontier exploration has no waypoints: the frontiers it may go to -->
        <remap from="waypoint_markers" to="/frontier_explorer/frontiers"
               if="$(eval explore == 'frontier')"/>
    </node>

    <!-- ============================== -->
    <!-- Frontier exploration           -->
    <!-- ============================== -->
    <node if="$(eval explore == 'frontier')" pkg="star_nav_bringup" type="frontier_explorer.py"
          name="frontier_explorer" output="screen">
        <remap from="cloud" to="/drone_$(arg drone_id)_lidar/cloud"/>
        <remap from="lidar_pose" to="/drone_$(arg drone_id)_lidar/pose"/>
        <remap from="odom" to="/drone_$(arg drone_id)_$(arg odom_topic)"/>
        <param name="altitude" value="$(arg altitude)"/>
        <param name="robot_height" value="$(arg robot_height)"/>
        <param name="max_step" value="$(arg max_step)"/>
        <!-- Goals a little further from obstacles than the planner keeps -->
        <param name="clearance" value="$(eval arg('obstacles_inflation') + 0.1)"/>
        <param name="area_center_x" value="$(arg exploration_center_x)"/>
        <param name="area_center_y" value="$(arg exploration_center_y)"/>
        <param name="area_width" value="$(eval arg('exploration_width') + 2 * arg('frontier_margin'))"/>
        <param name="area_height" value="$(eval arg('exploration_height') + 2 * arg('frontier_margin'))"/>
    </node>

    <!-- ============================== -->
    <!-- Planning stack and RViz        -->
    <!-- ============================== -->
    <include file="$(find star_nav_bringup)/launch/planning_stack.xml">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="robot_type" value="$(arg robot_type)"/>
        <arg name="planner" value="$(arg planner)"/>
        <arg name="obj_num" value="$(arg obj_num)"/>
        <arg name="use_rviz" value="$(arg use_rviz)"/>
        <!-- The lidar's returns and an angled view of the house -->
        <arg name="rviz_config" value="$(find star_nav_bringup)/config/star_nav_legged.rviz"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="exploration_center_x" value="$(arg exploration_center_x)"/>
        <arg name="exploration_center_y" value="$(arg exploration_center_y)"/>
        <arg name="exploration_width" value="$(arg exploration_width)"/>
        <arg name="exploration_height" value="$(arg exploration_height)"/>
        <arg name="line_spacing" value="$(arg line_spacing)"/>
        <arg name="enable_corner_smoothing" value="$(arg enable_corner_smoothing)"/>
        <arg name="explore" value="$(arg explore)"/>
        <arg name="cx" value="320.0"/>
        <arg name="cy" value="240.0"/>
        <arg name="fx" value="387.229248046875"/>
        <arg name="fy" value="387.229248046875"/>
        <arg name="obstacles_inflation" value="$(arg obstacles_inflation)"/>
        <arg name="sensor" value="lidar"/>
        <arg name="cloud_topic" value="lidar/cloud"/>
        <!-- In the frame of the robot's body -->
        <arg name="lidar_offset" value="$(arg lidar_offset)"/>
        <arg name="robot_height" value="$(arg robot_height)"/>
        <arg name="cmu_obstacle_height" value="$(arg cmu_obstacle_height)"/>
        <arg name="cmu_path_scale" value="$(arg cmu_path_scale)"/>
        <arg name="cmu_min_path_scale" value="$(arg cmu_min_path_scale)"/>
        <!-- Waypoints at body height -->
        <arg name="altitude" value="$(arg altitude)"/>
        <arg name="max_vel" value="$(arg max_vel)"/>
        <arg name="max_acc" value="1.0"/>
        <arg name="waypoint_tolerance" value="0.3"/>
        <!-- Rows are 9 m at 0.5-0.6 m/s, with detours around furniture -->
        <arg name="waypoint_timeout" value="60.0"/>
    </include>

    <!-- ============================== -->
    <!-- RViz helpers                   -->
    <!-- ============================== -->
    <node pkg="odom_visualization" name="drone_$(arg drone_id)_odom_visualization" type="odom_visualization" output="screen">
        <remap from="~odom" to="/drone_$(arg drone_id)_$(arg odom_topic)"/>
        <param name="color/a" value="1.0"/>
        <param name="color/r" value="0.0"/>
        <param name="color/g" value="0.0"/>
        <param name="color/b" value="0.0"/>
        <param name="covariance_scale" value="100.0"/>
        <param name="robot_scale" value="1.0"/>
        <param name="tf45" value="false"/>
        <param name="drone_id" value="drone_id"/>
    </node>

    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_map"
          args="0 0 0 0 0 0 world map"/>
    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom"
          args="0 0 0 0 0 0 world odom"/>

</launch>

<launch>
    <!-- Planning stack shared by all simulators: EGO planner, trajectory
         server, exploration manager and RViz. The simulator must provide
         odometry, a depth image and the camera pose (see the args below). -->
    <arg name="drone_id"/>
    <!-- ego: EGO planner and trajectory server. cmu: neither (a ground robot
         with the CMU local planner, started by exploration_ground.launch);
         the exploration manager and RViz only. -->
    <arg name="planner" default="ego"/>
    <arg name="obj_num"/>
    <arg name="use_rviz"/>
    <arg name="map_size_x"/>
    <arg name="map_size_y"/>
    <arg name="map_size_z"/>
    <arg name="odom_topic"/>
    <arg name="exploration_center_x"/>
    <arg name="exploration_center_y"/>
    <arg name="exploration_width"/>
    <arg name="exploration_height"/>
    <arg name="line_spacing"/>
    <arg name="enable_corner_smoothing"/>
    <!-- Depth camera intrinsics -->
    <arg name="cx"/>
    <arg name="cy"/>
    <arg name="fx"/>
    <arg name="fy"/>
    <!-- Planner obstacle inflation (m): at least the vehicle radius -->
    <arg name="obstacles_inflation" default="0.099"/>
    <!-- Vehicle: speed limits, waypoint height, and for ground robots the
         height below which depth returns are floor rather than obstacles -->
    <arg name="max_vel" default="1.5"/>
    <arg name="max_acc" default="3.0"/>
    <arg name="planning_horizon" default="7.5"/>
    <arg name="altitude" default="1.0"/>
    <arg name="obstacle_min_height" default="-1000.0"/>
    <!-- Exploration timing (s) and arrival distance (m) -->
    <arg name="waypoint_timeout" default="30.0"/>
    <arg name="waypoint_tolerance" default="0.5"/>
    <arg name="max_exploration_time" default="300.0"/>
    <arg name="rviz_config" default="$(find star_nav_bringup)/config/star_nav.rviz"/>
    <!-- Ray-cast point cloud input into the probabilistic map -->
    <arg name="pointcloud_raycasting" default="false"/>
    <!-- Point cloud sensor position in the body frame (ray origin) -->
    <arg name="lidar_offset" default="[0.0, 0.0, 0.0]"/>
    <!-- Hide map voxels below this height in RViz (e.g. the ground) -->
    <arg name="visualization_min_height" default="-1000.0"/>
    <arg name="visualization_max_height" default="1.8"/>
    <!-- Map update (see plan_manage/launch/advanced_param.xml) -->
    <arg name="max_hits_per_update" default="1"/>
    <arg name="sliding_map" default="false"/>
    <arg name="sliding_size" default="20.0"/>
    <arg name="show_occ_time" default="false"/>

    <!-- ============================== -->
    <!-- 2. EGO Planner                 -->
    <!-- ============================== -->
    <include file="$(find ego_planner)/launch/advanced_param.xml" if="$(eval planner == 'ego')">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="map_size_x_" value="$(arg map_size_x)"/>
        <arg name="map_size_y_" value="$(arg map_size_y)"/>
        <arg name="map_size_z_" value="$(arg map_size_z)"/>
        <arg name="odometry_topic" value="$(arg odom_topic)"/>
        <arg name="obj_num_set" value="$(arg obj_num)" />

        <!-- Use simulated sensing -->
        <arg name="camera_pose_topic" value="pcl_render_node/camera_pose"/>
        <arg name="depth_topic" value="pcl_render_node/depth"/>
        <arg name="cloud_topic" value="pcl_render_node/cloud"/>

        <!-- Camera intrinsics -->
        <arg name="cx" value="$(arg cx)"/>
        <arg name="cy" value="$(arg cy)"/>
        <arg name="fx" value="$(arg fx)"/>
        <arg name="fy" value="$(arg fy)"/>
        <arg name="obstacles_inflation" value="$(arg obstacles_inflation)"/>
        <arg name="obstacle_min_height" value="$(arg obstacle_min_height)"/>
        <arg name="pointcloud_raycasting" value="$(arg pointcloud_raycasting)"/>
        <arg name="lidar_offset" value="$(arg lidar_offset)"/>
        <arg name="visualization_min_height" value="$(arg visualization_min_height)"/>
        <arg name="visualization_max_height" value="$(arg visualization_max_height)"/>
        <arg name="max_hits_per_update" value="$(arg max_hits_per_update)"/>
        <arg name="sliding_map" value="$(arg sliding_map)"/>
        <arg name="sliding_size" value="$(arg sliding_size)"/>
        <arg name="show_occ_time" value="$(arg show_occ_time)"/>

        <!-- Planning parameters -->
        <arg name="max_vel" value="$(arg max_vel)" />
        <arg name="max_acc" value="$(arg max_acc)" />
        <arg name="planning_horizon" value="$(arg planning_horizon)" />
        <arg name="use_distinctive_trajs" value="false" />

        <!-- Manual target mode for exploration -->
        <arg name="flight_type" value="1" />

        <!-- Dummy waypoints (not used in manual mode) -->
        <arg name="point_num" value="0" />
        <arg name="point0_x" value="0" />
        <arg name="point0_y" value="0" />
        <arg name="point0_z" value="0" />
        <arg name="point1_x" value="0" />
        <arg name="point1_y" value="0" />
        <arg name="point1_z" value="0" />
        <arg name="point2_x" value="0" />
        <arg name="point2_y" value="0" />
        <arg name="point2_z" value="0" />
        <arg name="point3_x" value="0" />
        <arg name="point3_y" value="0" />
        <arg name="point3_z" value="0" />
        <arg name="point4_x" value="0" />
        <arg name="point4_y" value="0" />
        <arg name="point4_z" value="0" />
    </include>

    <!-- ============================== -->
    <!-- 3. Trajectory Server           -->
    <!-- ============================== -->
    <node pkg="ego_planner" name="drone_$(arg drone_id)_traj_server" type="traj_server" output="screen"
          if="$(eval planner == 'ego')">
        <remap from="~planning/bspline" to="drone_$(arg drone_id)_planning/bspline"/>
        <remap from="/position_cmd" to="/drone_$(arg drone_id)_planning/pos_cmd"/>
        <param name="traj_server/time_forward" value="1.0" type="double"/>
    </node>

    <!-- ============================== -->
    <!-- 4. Exploration Manager         -->
    <!-- ============================== -->
    <node pkg="exploration_manager" type="exploration_node" name="exploration_node" output="screen">
        
        <!-- Remap odometry for simulation -->
        <remap from="/mavros/local_position/odom" to="/drone_$(arg drone_id)_$(arg odom_topic)"/>
        
        <!-- Simulation mode -->
        <param name="use_sim" value="true" />

        <!-- FSM Parameters -->
        <param name="fsm/fsm_exec_dt" value="0.1" type="double"/>
        <param name="fsm/replan_time" value="0.05" type="double"/>
        <param name="fsm/max_exploration_time" value="$(arg max_exploration_time)" type="double"/>
        <param name="fsm/waypoint_timeout" value="$(arg waypoint_timeout)" type="double"/>
        <param name="fsm/waypoint_tolerance" value="$(arg waypoint_tolerance)" type="double"/>

        <!-- Waypoint Mode Parameters -->
        <param name="exploration/center_x" value="$(arg exploration_center_x)" type="double"/>
        <param name="exploration/center_y" value="$(arg exploration_center_y)" type="double"/>
        <param name="exploration/center_z" value="$(arg altitude)" type="double"/>
        <param name="exploration/width" value="$(arg exploration_width)" type="double"/>
        <param name="exploration/height" value="$(arg exploration_height)" type="double"/>
        <param name="exploration/altitude" value="$(arg altitude)" type="double"/>
        <param name="exploration/line_spacing" value="$(arg line_spacing)" type="double"/>
        <param name="exploration/enable_corner_smoothing" value="$(arg enable_corner_smoothing)" type="bool"/>
    </node>

    <!-- ============================== -->
    <!-- 5. RViz Visualization          -->
    <!-- ============================== -->
    <node name="rviz" pkg="rviz" type="rviz"
          args="-d $(arg rviz_config)"
          if="$(arg use_rviz)">
        <!-- Suppress the modal Noetic end-of-life dialog -->
        <env name="DISABLE_ROS1_EOL_WARNINGS" value="1" />
        <!-- GCS panel listens to the PX4 odometry topic -->
        <remap from="/mavros/local_position/odom" to="/drone_0_visual_slam/odom" />
    </node>

</launch>

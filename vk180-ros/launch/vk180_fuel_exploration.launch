<?xml version="1.0"?>
<launch>
  <!-- ============================================ -->
  <!-- VK180 + PX4 + FUEL Exploration Integration  -->
  <!-- Complete Autonomous Exploration System      -->
  <!-- ============================================ -->
  
  <arg name="drone_id" default="0"/>
  
  <!-- Map Parameters - REDUCED for Jetson memory constraints -->
  <arg name="map_size_x" default="10.0"/>
  <arg name="map_size_y" default="10.0"/>
  <arg name="map_size_z" default="3.0"/>
  
  <!-- Exploration Bounds - Must be within map size -->
  <arg name="box_min_x" default="-5.0"/>
  <arg name="box_min_y" default="-5.0"/>
  <arg name="box_min_z" default="0.5"/>
  <arg name="box_max_x" default="5.0"/>
  <arg name="box_max_y" default="5.0"/>
  <arg name="box_max_z" default="2.5"/>
  
  <!-- ============================================ -->
  <!-- 1. VK180 Vision Sensor Bridge               -->
  <!-- ============================================ -->
  <!-- This node bridges VK180 sensor data to ROS -->
  <!-- Publishes:
       - /vk180/odom_raw: Raw VIO odometry (before PX4 fusion)
       - /vk180/pointcloud: Merged point cloud from dual stereo cameras
       - /mavros/vision_pose/pose: Vision pose to PX4 EKF2 for fusion
       Subscribes:
       - /mavros/local_position/odom: Fused odometry from PX4
  -->
  <node name="vk180_planner_bridge" 
        pkg="vk180_ros" 
        type="vk180_planner_bridge" 
        output="screen"
        required="false">
    
    <!-- Frame IDs -->
    <param name="odom_frame_id" value="odom" />
    <param name="base_frame_id" value="base_link" />
    
    <!-- Point Cloud Parameters -->
    <param name="use_body_frame_transform" value="true" />
    <param name="subscribe_to_image_stream" value="true" />
    <param name="max_depth" value="10.0" />
    <param name="min_depth" value="0.4" />  <!-- Filter out near-field artifacts -->
    
  </node>
  
  <!-- ============================================ -->
  <!-- 2. PX4 Flight Controller (via MAVROS)      -->
  <!-- ============================================ -->
  <!-- Assumes MAVROS is running externally -->
  <!-- Expected topics:
       - /mavros/local_position/odom: Fused odometry (EKF2)
       - /mavros/vision_pose/pose: Vision input to EKF2
       - /mavros/setpoint_position/local: Position commands
  -->
  
  <!-- PX4 Controller (if using px4ctrl) -->
  <node pkg="px4ctrl" type="px4ctrl_node" name="px4ctrl_node" output="screen" required="false">
    <remap from="~odom" to="/mavros/local_position/odom"/>
    <remap from="~cmd" to="/planning/pos_cmd"/>
    <rosparam file="$(find px4ctrl)/config/ctrl_param_fpv.yaml"/>
    <param name="use_bodyrate_ctrl" value="false"/>
  </node>
  
  <!-- ============================================ -->
  <!-- 3. FUEL Exploration System                  -->
  <!-- ============================================ -->
  
  <!-- Main exploration node -->
  <node pkg="exploration_manager" 
        name="exploration_node" 
        type="exploration_node" 
        output="screen"
        required="false">
    
    <!-- ============================================ -->
    <!-- CRITICAL TOPIC REMAPPINGS                   -->
    <!-- ============================================ -->
    <!-- FUEL expects these specific topic names:
         - /odom_world: Odometry in world frame
         - /map_ros/cloud: Point cloud input
         - /map_ros/pose: Camera/sensor pose (usually same as odom)
    -->
    <remap from="/odom_world" to="/mavros/local_position/odom"/>
    <remap from="/map_ros/cloud" to="/vk180/pointcloud"/>
    <remap from="/map_ros/pose" to="/mavros/local_position/pose"/>
    
    <!-- ============================================ -->
    <!-- VK180 Integration Settings                  -->
    <!-- ============================================ -->
    <!-- VK180 provides point clouds, NOT depth images -->
    <param name="map_ros/use_depth_image" value="false"/>
    <param name="map_ros/use_cloud" value="true"/>
    <param name="map_ros/frame_id" value="odom"/>
    
    <!-- ============================================ -->
    <!-- SDF Map Parameters                          -->
    <!-- ============================================ -->
    <!-- Global persistent map (never forgets) -->
    <param name="sdf_map/resolution" value="0.2"/>  <!-- 0.2m for faster computation -->
    <param name="sdf_map/map_size_x" value="$(arg map_size_x)"/>
    <param name="sdf_map/map_size_y" value="$(arg map_size_y)"/>
    <param name="sdf_map/map_size_z" value="$(arg map_size_z)"/>
    <param name="sdf_map/obstacles_inflation" value="0.3"/>  <!-- Safety margin -->
    <param name="sdf_map/local_bound_inflate" value="0.5"/>
    <param name="sdf_map/local_map_margin" value="50"/>
    <param name="sdf_map/ground_height" value="0.0"/>
    <param name="sdf_map/default_dist" value="0.0"/>
    
    <!-- Occupancy Mapping (Probabilistic) -->
    <param name="sdf_map/p_hit" value="0.65"/>
    <param name="sdf_map/p_miss" value="0.35"/>
    <param name="sdf_map/p_min" value="0.12"/>
    <param name="sdf_map/p_max" value="0.90"/>
    <param name="sdf_map/p_occ" value="0.80"/>
    <param name="sdf_map/min_ray_length" value="0.3"/>
    <param name="sdf_map/max_ray_length" value="10.0"/>
    <param name="sdf_map/virtual_ceil_height" value="10.0"/>
    <param name="sdf_map/optimistic" value="false"/>
    <param name="sdf_map/signed_dist" value="false"/>
    
    <!-- Exploration Bounds (Geofence) -->
    <param name="sdf_map/box_min_x" value="$(arg box_min_x)"/>
    <param name="sdf_map/box_min_y" value="$(arg box_min_y)"/>
    <param name="sdf_map/box_min_z" value="$(arg box_min_z)"/>
    <param name="sdf_map/box_max_x" value="$(arg box_max_x)"/>
    <param name="sdf_map/box_max_y" value="$(arg box_max_y)"/>
    <param name="sdf_map/box_max_z" value="$(arg box_max_z)"/>
    
    <!-- ============================================ -->
    <!-- Point Cloud Processing (VK180 Specific)     -->
    <!-- ============================================ -->
    <param name="map_ros/skip_pixel" value="2"/>  <!-- Downsample for speed -->
    <param name="map_ros/depth_filter_maxdist" value="10.0"/>
    <param name="map_ros/depth_filter_mindist" value="0.4"/>  <!-- Match VK180 min_depth -->
    <param name="map_ros/depth_filter_margin" value="2"/>
    <param name="map_ros/esdf_slice_height" value="1.0"/>
    <param name="map_ros/visualization_truncate_height" value="5.0"/>
    <param name="map_ros/visualization_truncate_low" value="-0.5"/>
    <param name="map_ros/show_occ_time" value="false"/>
    <param name="map_ros/show_esdf_time" value="false"/>
    <param name="map_ros/show_all_map" value="true"/>
    
    <!-- ============================================ -->
    <!-- FSM Parameters                              -->
    <!-- ============================================ -->
    <param name="fsm/thresh_replan1" value="0.5"/>
    <param name="fsm/thresh_replan2" value="0.5"/>
    <param name="fsm/thresh_no_replan" value="2.0"/>
    <param name="fsm/waypoint_num" value="1"/>
    
    <!-- ============================================ -->
    <!-- Planner Parameters (CONSERVATIVE FOR REAL HW)-->
    <!-- ============================================ -->
    <param name="manager/max_vel" value="0.8"/>  <!-- Conservative velocity -->
    <param name="manager/max_acc" value="0.8"/>  <!-- Conservative acceleration -->
    <param name="manager/max_jerk" value="3.0"/>
    <param name="manager/control_points_distance" value="0.5"/>
    <param name="manager/dynamic" value="1"/>
    <param name="manager/clearance" value="0.4"/>  <!-- Larger safety clearance -->
    
    <!-- ============================================ -->
    <!-- B-spline Optimization Parameters            -->
    <!-- ============================================ -->
    <param name="optimization/lambda1" value="10.0"/>   <!-- Smoothness -->
    <param name="optimization/lambda2" value="5.0"/>    <!-- Distance -->
    <param name="optimization/lambda3" value="0.0001"/> <!-- Feasibility -->
    <param name="optimization/lambda4" value="0.01"/>   <!-- Endpoint -->
    <param name="optimization/lambda5" value="1.5"/>    <!-- Guide -->
    <param name="optimization/lambda6" value="10.0"/>   <!-- Bound -->
    <param name="optimization/lambda7" value="100.0"/>  <!-- Collision -->
    <param name="optimization/lambda8" value="0.0"/>    <!-- Time -->
    <param name="optimization/max_iteration_num1" value="2"/>
    <param name="optimization/max_iteration_num2" value="300"/>
    <param name="optimization/max_iteration_num3" value="200"/>
    <param name="optimization/max_iteration_num4" value="200"/>
    <param name="optimization/max_iteration_time1" value="0.0001"/>
    <param name="optimization/max_iteration_time2" value="0.005"/>
    <param name="optimization/max_iteration_time3" value="0.003"/>
    <param name="optimization/max_iteration_time4" value="0.003"/>
    <param name="optimization/algorithm1" value="15"/>
    <param name="optimization/algorithm2" value="11"/>
    <param name="optimization/order" value="3"/>
    
    <!-- ============================================ -->
    <!-- Exploration Parameters                      -->
    <!-- ============================================ -->
    <param name="exploration/refine_local" value="true"/>
    <param name="exploration/refined_num" value="7"/>
    <param name="exploration/refined_radius" value="5.0"/>
    <param name="exploration/top_view_num" value="15"/>
    <param name="exploration/max_decay" value="0.9"/>
    <param name="exploration/tsp_dir" value="$(find exploration_manager)/resource"/>
    <param name="exploration/relax_time" value="1.0"/>
    
    <!-- ============================================ -->
    <!-- Frontier Detection Parameters               -->
    <!-- ============================================ -->
    <param name="frontier/cluster_min" value="50"/>  <!-- Minimum frontier size -->
    <param name="frontier/cluster_size_xy" value="2.0"/>
    <param name="frontier/cluster_size_z" value="10.0"/>
    <param name="frontier/min_candidate_dist" value="0.75"/>
    <param name="frontier/min_candidate_clearance" value="0.5"/>
    <param name="frontier/candidate_dphi" value="45"/>
    <param name="frontier/candidate_rnum" value="3"/>
    <param name="frontier/candidate_rmin" value="0.75"/>
    <param name="frontier/candidate_rmax" value="1.5"/>
    <param name="frontier/down_sample" value="3"/>
    <param name="frontier/min_visib_num" value="20"/>
    <param name="frontier/min_view_finish_fraction" value="0.2"/>
    
    <!-- ============================================ -->
    <!-- Perception Utils (Camera FOV)               -->
    <!-- ============================================ -->
    <!-- VK180 stereo camera FOV approximations -->
    <param name="perception_utils/top_angle" value="0.56125"/>     <!-- ~32° -->
    <param name="perception_utils/left_angle" value="0.69222"/>    <!-- ~40° -->
    <param name="perception_utils/right_angle" value="0.68835"/>   <!-- ~39° -->
    <param name="perception_utils/max_dist" value="4.5"/>
    <param name="perception_utils/vis_dist" value="1.0"/>
    
    <!-- ============================================ -->
    <!-- A* Path Search Parameters (CRITICAL!)       -->
    <!-- ============================================ -->
    <!-- MUST set allocate_num to prevent memory crash -->
    <param name="astar/lambda_heu" value="10000.0"/>
    <param name="astar/resolution_astar" value="0.2"/>  <!-- Match sdf_map/resolution -->
    <param name="astar/allocate_num" value="100000"/>   <!-- Reduced for 10x10x3m map -->
    <param name="astar/max_search_time" value="0.001"/>
  </node>
  
  <!-- ============================================ -->
  <!-- 4. Trajectory Server                        -->
  <!-- ============================================ -->
  <!-- Converts B-spline trajectories to position commands -->
  <node pkg="plan_manage" 
        name="traj_server" 
        type="traj_server" 
        output="screen"
        required="false">
    
    <remap from="/position_cmd" to="/planning/pos_cmd"/>
    <remap from="/planning/bspline" to="/planning/bspline"/>
    
    <param name="traj_server/time_forward" value="1.5"/>
  </node>
  
  <!-- ============================================ -->
  <!-- 5. Static TF Transforms                     -->
  <!-- ============================================ -->
  <!-- World -> Odom -->
  <node pkg="tf2_ros" type="static_transform_publisher" 
        name="world_to_odom"
        args="0 0 0 0 0 0 world odom" />
  
  <!-- Dynamic transforms published by vk180_planner_bridge:
       - odom -> base_link (from VIO)
       - base_link -> camera_link (from VK180 extrinsics)
  -->
  
  <!-- ============================================ -->
  <!-- 6. RViz Visualization (Optional)            -->
  <!-- ============================================ -->
  <!-- Uncomment to launch RViz with FUEL visualization -->
  <!--
  <node pkg="rviz" type="rviz" name="fuel_rviz" 
        args="-d $(find exploration_manager)/launch/rviz_fuel.rviz"
        if="false"/>
  -->
  
</launch>

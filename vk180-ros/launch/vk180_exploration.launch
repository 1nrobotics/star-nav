<?xml version="1.0"?>
<launch>
    <!-- ============================================ -->
    <!-- VK180 + PX4 + EGO Planner + Autonomous Exploration -->
    <!-- Based on working vk180_autonomous_flight.launch -->
    <!-- ============================================ -->
    
    <!-- Arguments -->
    <arg name="use_sim" default="false" />
    <arg name="fcu_url_sim" default="udp://:14540@127.0.0.1:14557" />
    <arg name="fcu_url_real" default="/dev/ttyUSB0:921600" />
    <arg name="gcs_url" default="udp-b://@" />
    <arg name="use_body_frame_transform" default="true" />
    <arg name="drone_id" default="0"/>
    <arg name="use_rviz" default="false"/>
    
    <!-- Map Parameters -->
    <arg name="map_size_x" default="50"/>
    <arg name="map_size_y" default="50"/>
    <arg name="map_size_z" default="5.0"/>
    
    <!-- Planning Parameters -->
    <arg name="max_vel" default="0.8" />
    <arg name="max_acc" default="1.0" />
    
    <!-- ============================== -->
    <!-- 1. VK180 Vision Sensor Bridge  -->
    <!-- ============================== -->
    <!-- Provides raw VIO odometry and sensor data -->
    <!-- Also publishes vision pose directly to MAVROS for PX4 EKF2 fusion -->
    <node name="vk180_planner_bridge" 
          pkg="vk180_ros" 
          type="vk180_planner_bridge" 
          output="screen">
        
        <!-- Frame IDs -->
        <param name="odom_frame_id" value="odom" />
        <param name="base_frame_id" value="base_link" />
        
        <!-- Depth Processing Parameters -->
        <param name="use_body_frame_transform" value="$(arg use_body_frame_transform)" />
        <param name="subscribe_to_image_stream" value="true" />
        <param name="max_depth" value="10.0" />
        <param name="min_depth" value="0.4" />
        
        <!-- Sensor Outputs for Exploration:
             - /vk180/pointcloud: World-frame point cloud (pcl::PointXYZ)
             - /vk180/depth/image_rect_raw: Virtual depth image (16UC1, millimeters)
             - /vk180/depth/camera_info: Virtual camera intrinsics
             - /vk180/camera_extrinsic: Camera-to-body transform for depth processing
        -->
        
        <!-- Note: 
             - Publishes /vk180/odom_raw (raw VIO before PX4 fusion)
             - Publishes /mavros/vision_pose/pose (vision input to PX4 EKF2)
             - PX4 fuses VIO + IMU → /mavros/local_position/odom
        -->
    </node>
    
    <!-- ============================== -->
    <!-- 2. PX4 Controller              -->
    <!-- ============================== -->
    <!-- Uses fused odometry from PX4 EKF2 (VIO + IMU) -->
    <node pkg="px4ctrl" type="px4ctrl_node" name="px4ctrl" output="screen">
        <!-- Remap to PX4's fused odometry (VIO + IMU fusion) -->
        <remap from="~odom" to="/mavros/local_position/odom" />
        
        <!-- Command input from EGO planner trajectory -->
        <remap from="~cmd" to="/drone_$(arg drone_id)_planning/pos_cmd" />
        
        <!-- Load PX4 controller parameters -->
        <rosparam command="load" file="$(find px4ctrl)/config/ctrl_param_fpv.yaml" />
    </node>
    
    <!-- ============================== -->
    <!-- 3. EGO Planner                 -->
    <!-- ============================== -->
    <include file="$(find ego_planner)/launch/advanced_param_exp.xml">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="map_size_x_" value="$(arg map_size_x)"/>
        <arg name="map_size_y_" value="$(arg map_size_y)"/>
        <arg name="map_size_z_" value="$(arg map_size_z)"/>
        
        <!-- Use PX4's fused odometry (VIO + IMU) instead of raw VIO -->
        <arg name="odometry_topic" value="/mavros/local_position/odom"/>
        <arg name="depth_topic" value="nouse1"/>
        <arg name="camera_pose_topic" value="nouse2"/>
        <arg name="cloud_topic" value="/vk180/pointcloud"/>
        
        <!-- Camera Intrinsics (not used for point cloud mapping) -->
        <arg name="cx" value="320.0"/>
        <arg name="cy" value="240.0"/>
        <arg name="fx" value="400.0"/>
        <arg name="fy" value="400.0"/>
        
        <!-- Planning Parameters -->
        <arg name="max_vel" value="$(arg max_vel)" />
        <arg name="max_acc" value="$(arg max_acc)" />
        <arg name="planning_horizon" value="6" />
        <arg name="use_distinctive_trajs" value="false" />
        
        <!-- Flight Mode: 1 = MANUAL_TARGET (accepts /move_base_simple/goal) -->
        <!-- exploration_manager publishes frontier goals to this topic -->
        <arg name="flight_type" value="1" />
        
        <!-- Preset waypoints (not used in MANUAL_TARGET mode) -->
        <arg name="point_num" value="0" />
        <arg name="point0_x" value="0.0" />
        <arg name="point0_y" value="0.0" />
        <arg name="point0_z" value="0.0" />
        <arg name="point1_x" value="0.0" />
        <arg name="point1_y" value="0.0" />
        <arg name="point1_z" value="0.0" />
        <arg name="point2_x" value="0.0" />
        <arg name="point2_y" value="0.0" />
        <arg name="point2_z" value="0.0" />
        <arg name="point3_x" value="0.0" />
        <arg name="point3_y" value="0.0" />
        <arg name="point3_z" value="0.0" />
        <arg name="point4_x" value="0.0" />
        <arg name="point4_y" value="0.0" />
        <arg name="point4_z" value="0.0" />
        
        <!-- Moving Objects -->
        <arg name="obj_num_set" value="0" />
    </include>
    
    <!-- ============================== -->
    <!-- 4. Trajectory Server           -->
    <!-- ============================== -->
    <node pkg="ego_planner" name="drone_$(arg drone_id)_traj_server" type="traj_server" output="screen">
        <remap from="~planning/bspline" to="drone_$(arg drone_id)_planning/bspline"/>
        <remap from="/position_cmd" to="/drone_$(arg drone_id)_planning/pos_cmd"/>
        <param name="traj_server/time_forward" value="1.0" type="double"/>
    </node>
    
    <!-- ============================== -->
    <!-- 5. Exploration Manager         -->
    <!-- ============================== -->
    <node pkg="exploration_manager" type="exploration_node" name="exploration_node" output="screen">
        
        <!-- FSM Parameters -->
        <param name="fsm/fsm_exec_dt" value="0.1" type="double"/>
        <param name="fsm/replan_time" value="0.05" type="double"/>
        <param name="fsm/max_exploration_time" value="600.0" type="double"/> <!-- 10 minutes -->
        <param name="fsm/waypoint_timeout" value="30.0" type="double"/> <!-- Timeout per waypoint -->
        
        <!-- Waypoint Mode Parameters -->
        <param name="exploration/center_x" value="0.0" type="double"/>
        <param name="exploration/center_y" value="0.0" type="double"/>
        <param name="exploration/center_z" value="1.5" type="double"/>
        <param name="exploration/width" value="8.0" type="double"/>  <!-- Rectangle width -->
        <param name="exploration/height" value="8.0" type="double"/> <!-- Rectangle height -->
        <param name="exploration/altitude" value="1.5" type="double"/> <!-- Waypoint altitude -->
        <param name="exploration/line_spacing" value="0.5" type="double"/> <!-- Distance between lines -->
        
        <!-- Map Parameters (MUST MATCH EGO planner for consistency) -->
        <param name="grid_map/resolution" value="0.15" type="double"/>  <!-- Match EGO planner -->
        <param name="grid_map/map_size_x" value="$(arg map_size_x)" type="double"/>
        <param name="grid_map/map_size_y" value="$(arg map_size_y)" type="double"/>
        <param name="grid_map/map_size_z" value="$(arg map_size_z)" type="double"/>
        <!-- IMPORTANT: Must be >= max_exploration_radius to avoid forgetting old map data -->
        <param name="grid_map/local_update_range_x" value="30.0" type="double"/>
        <param name="grid_map/local_update_range_y" value="30.0" type="double"/>
        <param name="grid_map/local_update_range_z" value="5.0" type="double"/>
        <param name="grid_map/obstacles_inflation" value="0.2" type="double"/>  <!-- Match EGO planner -->
        
        <!-- Occupancy probability parameters (match EGO planner) -->
        <param name="grid_map/p_hit"  value="0.65" type="double"/>
        <param name="grid_map/p_miss" value="0.35" type="double"/>
        <param name="grid_map/p_min"  value="0.12" type="double"/>
        <param name="grid_map/p_max"  value="0.90" type="double"/>
        <param name="grid_map/p_occ"  value="0.80" type="double"/>
        <param name="grid_map/min_ray_length" value="0.3" type="double"/>
        <param name="grid_map/max_ray_length" value="10.0" type="double"/>
        
        <!-- Camera intrinsics for depth image processing (match VK180 virtual camera) -->
        <param name="grid_map/cx" value="320.0" type="double"/>
        <param name="grid_map/cy" value="240.0" type="double"/>
        <param name="grid_map/fx" value="320.0" type="double"/>
        <param name="grid_map/fy" value="320.0" type="double"/>
        
        <!-- Depth image filtering -->
        <param name="grid_map/use_depth_filter" value="true" type="bool"/>
        <param name="grid_map/depth_filter_tolerance" value="0.15" type="double"/>
        <param name="grid_map/depth_filter_maxdist" value="10.0" type="double"/>
        <param name="grid_map/depth_filter_mindist" value="0.3" type="double"/>
        <param name="grid_map/depth_filter_margin" value="2" type="int"/>
        <param name="grid_map/k_depth_scaling_factor" value="1000.0" type="double"/> <!-- 16UC1 in millimeters -->
        <param name="grid_map/skip_pixel" value="2" type="int"/>  <!-- Process every 2nd pixel for speed -->
        
        <!-- Visualization and map parameters -->
        <param name="grid_map/visualization_truncate_height" value="1.8" type="double"/>
        <param name="grid_map/show_occ_time" value="false" type="bool"/>
        <param name="grid_map/pose_type" value="2" type="int"/>  <!-- 2 = ODOMETRY -->
        <param name="grid_map/frame_id" value="world" type="string"/>
        
        <!-- CRITICAL: Disable pointcloud raycasting when using depth images -->
        <!-- Depth images provide better raycasting through projectDepthImage() -->
        <param name="grid_map/enable_pointcloud_raycasting" value="false" type="bool"/>
        
        <!-- Topic remapping -->
        <!-- GridMap subscribes in the node's private namespace ("~grid_map/*") -->
        <remap from="~grid_map/odom" to="/mavros/local_position/odom"/>
        <remap from="~grid_map/depth" to="/vk180/depth/image_rect_raw"/>
        <remap from="~grid_map/pose" to="/mavros/local_position/odom"/>  <!-- For depth+pose synchronization -->
        <remap from="~grid_map/cloud" to="nouse"/>  <!-- Disabled: using depth image instead -->
        
        <!-- Camera extrinsics (global topic - hardcoded in grid_map.cpp) -->
        <remap from="/vins_fusion/extrinsic" to="/vk180/camera_extrinsic"/>
        
    </node>
    
    <!-- ============================== -->
    <!-- 6. MAVROS                      -->
    <!-- ============================== -->
    <!-- MAVROS launch for simulation -->
    <group if="$(arg use_sim)">
        <include file="$(find mavros)/launch/px4.launch">
            <arg name="fcu_url" value="$(arg fcu_url_sim)" />
            <arg name="gcs_url" value="$(arg gcs_url)" />
        </include>
    </group>

    <!-- MAVROS launch for real hardware -->
    <group unless="$(arg use_sim)">
        <include file="$(find mavros)/launch/px4.launch">
            <arg name="fcu_url" value="$(arg fcu_url_real)" />
            <arg name="gcs_url" value="$(arg gcs_url)" />
        </include>
    </group>
    
    <!-- ============================== -->
    <!-- 7. Static TF Publishers        -->
    <!-- ============================== -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_map"
          args="0 0 0 0 0 0 world map" />
    
    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom"
          args="0 0 0 0 0 0 world odom" />
    
    <!-- Odometry TF (odom -> base_link) published dynamically by vk180_planner_bridge from VIO -->
    
    <!-- Camera transform published dynamically by vk180_planner_bridge from VK180 extrinsics -->
    
    <!-- Optional: Static transform for camera optical frame -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="camera_to_camera_optical"
          args="0 0 0 -1.5708 0 -1.5708 camera_link camera_optical_frame" />
    
    <!-- ============================== -->
    <!-- 8. RViz Visualization (Optional) -->
    <!-- ============================== -->
    <node name="rviz" pkg="rviz" type="rviz" 
          args="-d $(find vk180_ros)/config/vk180_planner_visualization.rviz" 
          if="$(arg use_rviz)" />
    
</launch>

<?xml version="1.0"?>
<launch>
    <!-- Enhanced VK180 Planner Integration with Body Frame Transformation -->
    
    <!-- Parameters -->
    <arg name="use_body_frame_transform" default="true" />
    <arg name="max_depth" default="10.0" />
    <arg name="min_depth" default="0.1" />
    <arg name="odom_frame_id" default="odom" />
    <arg name="base_frame_id" default="base_link" />
    
    <!-- Enhanced Planner Integration Node -->
    <node name="enhanced_planner_integration" 
          pkg="vk180_ros" 
          type="enhanced_planner_integration" 
          output="screen">
        
        <!-- Frame IDs -->
        <param name="odom_frame_id" value="$(arg odom_frame_id)" />
        <param name="base_frame_id" value="$(arg base_frame_id)" />
        
        <!-- Depth Processing Parameters -->
        <param name="use_body_frame_transform" value="$(arg use_body_frame_transform)" />
        <param name="max_depth" value="$(arg max_depth)" />
        <param name="min_depth" value="$(arg min_depth)" />
        
        <!-- Debug Parameters -->
        <param name="publish_debug_topics" value="true" />
        
    </node>
    
    <!-- Optional: Static transform for camera optical frame -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="camera_optical_frame_broadcaster"
          args="0 0 0 -1.5708 0 -1.5708 camera_link camera_optical_frame" />
    
    <!-- RViz Visualization -->
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find vk180_ros)/config/planner_integration.rviz" if="false" />
    
    <!-- Diagnostic Information -->
    <node name="diagnostic_aggregator" pkg="diagnostic_aggregator" type="aggregator_node">
        <rosparam command="load" file="$(find vk180_ros)/config/diagnostic_config.yaml" />
    </node>
    
</launch>
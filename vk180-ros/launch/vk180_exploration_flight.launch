<?xml version="1.0"?>
<launch>
  <!-- ============================================ -->
  <!-- VK180 + PX4 + FUEL Exploration Integration  -->
  <!-- Reuses algorithm.xml for consistency        -->
  <!-- ============================================ -->
  
  <!-- ODOMETRY CONFIGURATION:
       - VK180 bridge publishes:
         * /vk180/odom_raw: Raw VIO odometry
         * /mavros/vision_pose/pose: Vision input to PX4 EKF2
       - PX4 EKF2 fuses VIO + IMU → /mavros/local_position/odom
       - All nodes use the fused odometry for better accuracy
  -->
  
  <arg name="drone_id" default="0"/>
  
  <!-- MAVROS Configuration -->
  <arg name="use_sim" default="false"/>
  <arg name="fcu_url_sim" default="udp://:14540@127.0.0.1:14557"/>
  <arg name="fcu_url_real" default="/dev/ttyUSB0:921600"/>
  <arg name="gcs_url" default="udp-b://@"/>
  
  <!-- RViz visualization -->
  <arg name="use_rviz" default="false"/>
  
  <!-- Map size - adjust based on available memory -->
  <arg name="map_size_x" default="10.0"/>
  <arg name="map_size_y" default="10.0"/>
  <arg name="map_size_z" default="3.0"/>
  
  <!-- Initial position -->
  <arg name="init_x" default="0"/>
  <arg name="init_y" default="0"/>
  <arg name="init_z" default="1.0"/>
  
  <!-- ============================================ -->
  <!-- 1. VK180 Vision Sensor Bridge               -->
  <!-- ============================================ -->
  <!-- Publishes:
       - /vk180/odom_raw: Raw VIO odometry
       - /mavros/vision_pose/pose: Vision input to PX4 EKF2 for fusion
       - /vk180/pointcloud: Merged point cloud from stereo cameras
  -->
  <node name="vk180_planner_bridge" 
        pkg="vk180_ros" 
        type="vk180_planner_bridge" 
        output="screen"
        required="false">
    <param name="odom_frame_id" value="odom"/>
    <param name="base_frame_id" value="base_link"/>
    <param name="use_body_frame_transform" value="true"/>
    <param name="subscribe_to_image_stream" value="true"/>
    <param name="max_depth" value="10.0"/>
    <param name="min_depth" value="0.4"/>
  </node>
  
  <!-- ============================================ -->
  <!-- 2. MAVROS - PX4 Communication               -->
  <!-- ============================================ -->
  <!-- MAVROS for simulation -->
  <group if="$(arg use_sim)">
    <include file="$(find mavros)/launch/px4.launch">
      <arg name="fcu_url" value="$(arg fcu_url_sim)"/>
      <arg name="gcs_url" value="$(arg gcs_url)"/>
    </include>
  </group>
  
  <!-- MAVROS for real hardware -->
  <group unless="$(arg use_sim)">
    <include file="$(find mavros)/launch/px4.launch">
      <arg name="fcu_url" value="$(arg fcu_url_real)"/>
      <arg name="gcs_url" value="$(arg gcs_url)"/>
    </include>
  </group>
  
  <!-- ============================================ -->
  <!-- 3. PX4 Flight Controller                    -->
  <!-- ============================================ -->
  <!-- Uses PX4 EKF2 fused odometry (VIO + IMU fusion) -->
  <node pkg="px4ctrl" type="px4ctrl_node" name="px4ctrl_node" output="screen" required="false">
    <!-- Use PX4's fused odometry from EKF2 (VIO + IMU) -->
    <remap from="~odom" to="/mavros/local_position/odom"/>
    <remap from="~cmd" to="/planning/pos_cmd"/>
    <rosparam file="$(find px4ctrl)/config/ctrl_param_fpv.yaml"/>
    <param name="use_bodyrate_ctrl" value="false"/>
  </node>
  
  <!-- ============================================ -->
  <!-- 4. FUEL Exploration (using algorithm.xml)   -->
  <!-- ============================================ -->
  <include file="$(find exploration_manager)/launch/algorithm.xml">
    <!-- Map size -->
    <arg name="map_size_x_" value="$(arg map_size_x)"/>
    <arg name="map_size_y_" value="$(arg map_size_y)"/>
    <arg name="map_size_z_" value="$(arg map_size_z)"/>
    
    <!-- Exploration bounds (geofence) -->
    <arg name="box_min_x" value="-5.0"/>
    <arg name="box_min_y" value="-5.0"/>
    <arg name="box_min_z" value="0.0"/>
    <arg name="box_max_x" value="5.0"/>
    <arg name="box_max_y" value="5.0"/>
    <arg name="box_max_z" value="2.0"/>
    
    <!-- VK180 topic remappings - Use PX4 fused odometry -->
    <arg name="odometry_topic" value="/mavros/local_position/odom"/>
    <arg name="sensor_pose_topic" value="/mavros/vision_pose/pose"/>
    <arg name="depth_topic" value="/invalid_topic"/>  <!-- VK180 doesn't provide depth images -->
    <arg name="cloud_topic" value="/vk180/pointcloud"/>
    
    <!-- Camera intrinsics (not used for point cloud, but required by algorithm.xml) -->
    <arg name="cx" value="320.0"/>
    <arg name="cy" value="240.0"/>
    <arg name="fx" value="320.0"/>
    <arg name="fy" value="320.0"/>
    
    <!-- Conservative velocity/acceleration for real hardware -->
    <arg name="max_vel" value="0.8"/>
    <arg name="max_acc" value="0.8"/>
  </include>
  
  <!-- ============================================ -->
  <!-- 5. Trajectory Server                        -->
  <!-- ============================================ -->
  <node pkg="plan_manage" name="traj_server" type="traj_server" output="screen">
    <remap from="/position_cmd" to="/planning/pos_cmd"/>
    <!-- Use PX4 fused odometry (VIO + IMU) -->
    <remap from="/odom_world" to="/mavros/local_position/odom"/>
    
    <param name="traj_server/time_forward" value="1.5"/>
    <param name="traj_server/pub_traj_id" value="4"/>
    <param name="traj_server/init_x" value="$(arg init_x)"/>
    <param name="traj_server/init_y" value="$(arg init_y)"/>
    <param name="traj_server/init_z" value="$(arg init_z)"/>
    
    <!-- Camera FOV for trajectory server -->
    <param name="perception_utils/top_angle" value="0.56125"/>
    <param name="perception_utils/left_angle" value="0.69222"/>
    <param name="perception_utils/right_angle" value="0.68901"/>
    <param name="perception_utils/max_dist" value="4.5"/>
    <param name="perception_utils/vis_dist" value="1.0"/>
  </node>
  
  <!-- ============================================ -->
  <!-- 6. Waypoint Generator (Trigger)             -->
  <!-- ============================================ -->
  <!-- This node triggers exploration when receiving goals from RViz or other sources -->
  <node pkg="waypoint_generator" name="waypoint_generator" type="waypoint_generator" output="screen">
    <remap from="~odom" to="/mavros/local_position/odom"/>
    <remap from="~goal" to="/move_base_simple/goal"/>
    <remap from="~traj_start_trigger" to="/traj_start_trigger"/>
    <param name="waypoint_type" value="point"/>
  </node>
  
  <!-- Static TF Publishers -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_map"
        args="0 0 0 0 0 0 world map"/>
  
  <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom"
        args="0 0 0 0 0 0 world odom"/>
  
  <!-- ============================================ -->
  <!-- 7. RViz Visualization (Optional)            -->
  <!-- ============================================ -->
  <group if="$(arg use_rviz)">
    <node name="rvizvisualisation" pkg="rviz" type="rviz" output="log" 
          args="-d $(find plan_manage)/config/traj.rviz"/>
    <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_navigation"
          args="0 0 0 0 0 0 world navigation"/>
  </group>
  
</launch>

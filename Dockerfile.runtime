# Runtime-only Docker image for packed Star Nav workspace
# Expects a pre-built workspace archive (install + minimal src for launch files)
# Multi-architecture support: works for x86_64 and ARM64 (Jetson)

ARG BASE_IMAGE=ros:noetic-ros-core-focal
FROM ${BASE_IMAGE}

LABEL maintainer="1nrobotics@github"
LABEL description="Star Nav Runtime - Pre-built workspace for deployment"

# Set environment variables
ENV ROS_DISTRO=noetic
ENV DEBIAN_FRONTEND=noninteractive

# Install minimal runtime tools
RUN apt-get update && apt-get install --no-install-recommends -y \
    vim \
    wget \
    curl \
    tmux \
    iproute2 \
    python3-rosdep \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Bootstrap rosdep
RUN rosdep init && \
    rosdep update --rosdistro $ROS_DISTRO

# Install ROS runtime packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-noetic-ros-base=1.5.0-1* \
    && rm -rf /var/lib/apt/lists/*

# Install MAVROS and related dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-mavlink \
    ros-${ROS_DISTRO}-mavros \
    ros-${ROS_DISTRO}-mavros-msgs \
    ros-${ROS_DISTRO}-mavros-extras \
    ros-${ROS_DISTRO}-geometry-msgs \
    ros-${ROS_DISTRO}-tf2-ros \
    ros-${ROS_DISTRO}-tf2-geometry-msgs \
    && rm -rf /var/lib/apt/lists/*

# Install additional ROS packages for navigation and control
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-pcl-ros \
    ros-${ROS_DISTRO}-pcl-conversions \
    ros-${ROS_DISTRO}-eigen-conversions \
    ros-${ROS_DISTRO}-rviz \
    ros-${ROS_DISTRO}-cv-bridge \
    ros-${ROS_DISTRO}-image-transport \
    ros-${ROS_DISTRO}-xacro \
    ros-${ROS_DISTRO}-ddynamic-reconfigure \
    && rm -rf /var/lib/apt/lists/*

# Install system dependencies (runtime libraries only)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libeigen3-dev \
    libpcl-dev \
    libyaml-cpp-dev \
    libyaml-cpp0.6 \
    && rm -rf /var/lib/apt/lists/*

# Install eCAL using Vilota software installer
COPY docker/tools/VilotaSoftwareInstaller_v2.0-bba1a93f.py /tmp/installer.py
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3-requests \
        software-properties-common \
        sudo \
        apt-transport-https \
        ca-certificates \
        gnupg && \
    rm -rf /var/lib/apt/lists/*

# Install eCAL runtime (no build tools needed)
RUN apt-get update && \
    python3 /tmp/installer.py -s -u deployment -p vilota-dep --no-update-script && \
    rm -rf /var/lib/apt/lists/*

# Install eCAL Python bindings
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3-ecal5 && \
    rm -rf /var/lib/apt/lists/* || \
    echo "Warning: python3-ecal5 package not available"

# Verify installations
RUN python3 -c "import ecal; print('eCAL imported successfully')" || echo "Warning: eCAL import failed"
RUN python3 -c "import capnp; print(f'pycapnp {capnp.__version__} imported successfully')" || echo "Warning: pycapnp import failed"

# Movidius udev rule
RUN mkdir -p /etc/udev/rules.d && \
    echo 'SUBSYSTEM=="usb", ATTRS{idVendor}=="03e7", MODE="0666"' > /etc/udev/rules.d/80-movidius.rules || true

# Install MAVROS geographic datasets
RUN wget https://raw.githubusercontent.com/mavlink/mavros/master/mavros/scripts/install_geographiclib_datasets.sh \
    && bash ./install_geographiclib_datasets.sh \
    && rm install_geographiclib_datasets.sh

# Enable bash source keyword
SHELL ["/bin/bash", "-c"]

# Create workspace directory
WORKDIR /catkin_ws

# Copy pre-built workspace (install directory and minimal src with launch/config files)
# This expects the packed workspace to be extracted here
# Build context should contain: install/ and src/ (with only launch/config/scripts)
COPY install/ /catkin_ws/install/
COPY src/ /catkin_ws/src/

# Copy eCAL configuration
COPY docker/tools/ecal.ini /etc/ecal/ecal.ini

# Set up environment in bashrc - use install/setup.bash for release builds
RUN echo "source /opt/ros/noetic/setup.bash" >> /root/.bashrc && \
    echo "source /catkin_ws/install/setup.bash" >> /root/.bashrc

# Copy custom bashrc for additional configuration (if it exists)
COPY docker/.bashrc /root/.bashrc_custom
RUN cat /root/.bashrc_custom >> /root/.bashrc || true

# Set working directory
WORKDIR /catkin_ws

# Expose ROS and MAVROS ports
EXPOSE 11311 14540 14557

# Default environment variables
ENV PX4_SIM_HOST=localhost
ENV PX4_SIM_MODEL=iris

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
